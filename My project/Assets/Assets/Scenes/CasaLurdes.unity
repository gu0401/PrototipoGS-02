  m_Script: {fileID: 11500000, guid: 875cbf66ef3bf0c428914107d42c0435, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialCasa
  vovo: {fileID: 1210102395}
  gerenciador: {fileID: 2134008256}
  textoTutorial: {fileID: 273163716}
  falasIntroducao:
  - personagem: Tonin
    texto: "Aqui est\xE1 ele, o O.T.T.O"
    retrato: {fileID: 2408691220581485484, guid: 497cacb89deae0a418a348a499b59a01, type: 3}
    animacaoRetrato: {fileID: 0}
  - personagem: O.T.T.O
    texto: "Ol\xE1, Dona Lurdes! Posso avisar sobre obst\xE1culos pr\xF3ximos e emitir
      pulsos sonoros para ajudar na orienta\xE7\xE3o."
    retrato: {fileID: 0}
    animacaoRetrato: {fileID: 9100000, guid: c1d86def60795e94e995bf31c418d228, type: 2}
  - personagem: Dona Lurdes
    texto: "Oxente, j\xE1 ta vivo isso \xE9?!"
    retrato: {fileID: -1485821529, guid: 2d22cbe14877472468addb69e26420e4, type: 3}
    animacaoRetrato: {fileID: 0}
  - personagem: Tonin
    texto: Vamos experimentar! Primeiro, caminhe um pouquinho pela casa. Depois,
      teste a bengala e o Otto.
    retrato: {fileID: 2408691220581485484, guid: 497cacb89deae0a418a348a499b59a01, type: 3}
    animacaoRetrato: {fileID: 0}
  distanciaMovimento: 1
  cenaDestino: 
