  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 783803235}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a1dc3d738417ca3439aa43226bfa5655, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FinalFase01
  gerenciador: {fileID: 715412675}
  textoInteragir: {fileID: 867535505}
  falas:
  - personagem: "Dona Cec\xEDlia"
    texto: "Lurdes? \xC9 voc\xEA, mulher? Quanto tempo!"
    retrato: {fileID: -5144971400767166778, guid: b9beeb018a9d77b4fa644f29b063737a, type: 3}
    animacaoRetrato: {fileID: 0}
  - personagem: Dona Lurdes
    texto: "Sou eu mesma! Pensei que j\xE1 estava na hora de fazer uma visitinha."
    retrato: {fileID: -1485821529, guid: 2d22cbe14877472468addb69e26420e4, type: 3}
    animacaoRetrato: {fileID: 0}
  - personagem: "Dona Cec\xEDlia"
    texto: "Que alegria receber voc\xEA! Entre, temos muita conversa para colocar
      em dia."
    retrato: {fileID: -5144971400767166778, guid: b9beeb018a9d77b4fa644f29b063737a, type: 3}
    animacaoRetrato: {fileID: 0}
  - personagem: Dona Lurdes
    texto: "Vamos sim! E trouxe uma companhia nova! O O.T.T.O! Gra\xE7as a ele vir
      aqui se tornou muito mais f\xE1cil."
    retrato: {fileID: -1485821529, guid: 2d22cbe14877472468addb69e26420e4, type: 3}
    animacaoRetrato: {fileID: 9100000, guid: 72999c6ab9aea72449b65f70731b4216, type: 2}
  - personagem: O.T.T.O
    texto: "Ah obrigado Dona Lurdes e ol\xE1 Dona Cec\xEDlia! \xC9 um prazer te conhecer."
    retrato: {fileID: 0}
    animacaoRetrato: {fileID: 9100000, guid: c1d86def60795e94e995bf31c418d228, type: 2}
  painelConclusao: {fileID: 43266550}
  inputJogador: {fileID: 2081928417}
  nomeCenaMenu: Menu
