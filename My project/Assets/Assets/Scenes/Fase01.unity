  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogoNPC
  gerenciador: {fileID: 715412675}
  textoInteragir: {fileID: 386422661}
  falas:
  - personagem: Morador
    texto: "Bom dia, Dona Lurdes! Faz tempo que n\xE3o vejo a senhora por aqui."
    retrato: {fileID: 0}
    animacaoRetrato: {fileID: 9100000, guid: ab497260f634ba14380e00addfe87f88, type: 2}
  - personagem: Dona Lurdes
    texto: "Pois \xE9, meu filho! Hoje resolvi visitar uma velha amiga."
    retrato: {fileID: -1485821529, guid: 2d22cbe14877472468addb69e26420e4, type: 3}
    animacaoRetrato: {fileID: 0}
  - personagem: Morador
    texto: "Que bom! Tome cuidado, a rua \xE0 frente est\xE1 muito movimentada hoje."
    retrato: {fileID: 0}
    animacaoRetrato: {fileID: 9100000, guid: ab497260f634ba14380e00addfe87f88, type: 2}
